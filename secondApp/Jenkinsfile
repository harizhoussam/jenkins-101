pipeline {
  agent {
    label 'local-agent'
  }
  environment {
    TARGET_ENV = 'DEV'
    DIR = 'HOME'
  }
  parameters {
    string(name: 'TEST_VARIABLE' ,defaultValue: 'TEST123')
    choice(name: 'USER', choices:['HH','ZZ'])
    booleanParam(name: 'DEPLOY_NOW', defaultValue: true)
  }
  options {
        disableConcurrentBuilds()
  }
  stages {
    stage('First'){
      parallel {
        stage('F1'){
          steps {
            sh ''' echo "hello from F1 !"
            echo "The environment is $TARGET_ENV"'''
            }
          }
        stage('F2') {
          steps {
            echo "HELLO FROM F2"
          }
        }
      }  
    }

    stage('Second'){
      when {
        expression { return params.DEPLOY_NOW }
      }
      steps {
        sh ''' echo "hello from Second Stage !!!">test.txt 
        echo "The environment is $TARGET_ENV"'''
        stash includes: 'test.txt', name: 'my-stash'
      }
    }

    stage('Third'){
      input {
        message "Please Input Details"
        ok "Deply NOW"
        parameters { 
          string(name: 'CHECK' ,defaultValue: 'TEST123')
          choice(name: 'WHO', choices:['HH','ZZ'])
        }
      }
      steps {
        echo "---UNSTASHING NOW test.txt---"
        unstash 'my-stash'
        sh ''' cat test.txt'''
        script {
          if (DIR == 'HOME'){
            echo "THIS IS A SCRIPTED CONDITION !"
          }
        }
      }
    }
  }
  post {
    success {echo "Success"}
    failure {echo "Failure"}
    always {echo "....STAGES DONE...."}
  }
}
