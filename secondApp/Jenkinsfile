pipeline {
  agent {
    label 'local-agent'
  }
  environment {
    TARGET_ENV = 'DEV'
    DIR = 'HOME'
  }
  parameters {
    string(name: 'TEST_VARIABLE' ,defaultValue: 'TEST123')
    choice(name: 'USER', choices:['HH','ZZ'])
    booleanParam(name: 'DEPLOY_NOW', defaultValue: false)
  }
  stages {
    stage('First'){
      when {
        branch 'master'
      }
      steps {
        sh ''' echo "hello world !!!">test.txt 
        cat test.txt 
        echo "The environment is $TARGET_ENV"'''
      }
    }

    stage('Second'){
      steps {
        echo "HEY this is the directory: ${DIR}"
      }
    }
  }
}
